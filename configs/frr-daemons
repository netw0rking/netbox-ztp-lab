# Static /etc/frr/daemons for FRR-platform leafs (bind-mounted directly,
# not templated - no per-device field ever varies here). Only difference
# from frrouting/frr:latest's own shipped default: bgpd=yes instead of
# the image's default bgpd=no.
#
# Why this has to be baked in before container start, not toggled live
# by ztp_bootstrap.py:
# docker-start only reads this file once, at container boot, to decide
# which daemons to launch. Enabling a not-yet-running daemon therefore
# requires `frrinit.sh restart`, which - confirmed live - tears down and
# re-execs the whole daemon set from inside the running container, which
# in this image's own process model brings down the container's PID 1
# with it (Docker's restart policy then recreates the container from
# scratch, discarding the containerlab-wired veth links, which a plain
# container restart never restores). Pre-baking bgpd=yes here means
# bgpd is already running from first boot, so ztp_bootstrap.py only ever
# needs a live `vtysh -f` config load (no daemon start/stop, no restart,
# no container death) to apply the fetched config.
#
# The watchfrr, zebra and staticd daemons are always started.
#
bgpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1"
ospf6d_options=" -A ::1"
ripd_options="   -A 127.0.0.1"
ripngd_options=" -A ::1"
isisd_options="  -A 127.0.0.1"
pimd_options="   -A 127.0.0.1"
pim6d_options="  -A ::1"
ldpd_options="   -A 127.0.0.1"
nhrpd_options="  -A 127.0.0.1"
eigrpd_options=" -A 127.0.0.1"
babeld_options=" -A 127.0.0.1"
sharpd_options=" -A 127.0.0.1"
pbrd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
fabricd_options="-A 127.0.0.1"
vrrpd_options="  -A 127.0.0.1"
pathd_options="  -A 127.0.0.1"
