hostname {{ hostname }}
!
{% for user in users %}
{% if user.auth == 'ssh_key' %}
# Use 'ssh-key', not the deprecated 'sshkey' alias.
username {{ user.username }} privilege 15 role network-admin nopassword
username {{ user.username }} ssh-key {{ user.value }}
!
{% elif user.auth == 'password' %}
# Plaintext here; EOS stores a sha512 hash.
username {{ user.username }} privilege 15 role network-admin secret {{ user.value }}
!
{% endif %}
{% endfor %}
# Required before BGP or any L3 routing works.
ip routing
!
{% if mgmt_ip %}
interface Management0
   ip address {{ mgmt_ip }}
!
{% endif %}
{% for if_name, intf in interfaces.items() if intf.role == 'fabric' %}
interface {{ if_name }}
   description to {{ intf.connects_to.device }} {{ intf.connects_to.interface }}
   no switchport
   ip address {{ intf.ip }}
!
{% endfor %}
{% for if_name, intf in interfaces.items() if intf.role == 'oob' %}
interface {{ if_name }}
   description to {{ intf.connects_to.device }} {{ intf.connects_to.interface }}
!
{% endfor %}
interface Loopback0
   ip address {{ loopback }}
!
{% if overlay_vni %}
# VXLAN/EVPN overlay.
vlan {{ overlay_vlan_id }}
!
interface Vxlan1
   vxlan source-interface Loopback0
   vxlan vlan {{ overlay_vlan_id }} vni {{ overlay_vni }}
!
interface Vlan{{ overlay_vlan_id }}
   ip address {{ overlay_test_ip }}
!
{% endif %}
{% for if_name, intf in interfaces.items() if intf.role == 'overlay' %}
# Overlay test host: access port in the overlay VLAN.
interface {{ if_name }}
   description to {{ intf.connects_to.device }} {{ intf.connects_to.interface }}
   switchport access vlan {{ overlay_vlan_id }}
!
{% endfor %}
router bgp {{ bgp_asn }}
   router-id {{ loopback.split('/')[0] }}
{% for if_name, intf in interfaces.items() if intf.role == 'fabric' %}
   neighbor {{ intf.connects_to.peer_ip.split('/')[0] }} remote-as {{ intf.connects_to.peer_asn }}
{% endfor %}
   redistribute connected
{% if overlay_vni %}
   !
   # VLAN-based EVPN binding; needed to advertise routes.
   vlan {{ overlay_vlan_id }}
      rd {{ loopback.split('/')[0] }}:{{ overlay_vlan_id }}
      route-target both {{ overlay_vni }}:{{ overlay_vni }}
      redistribute learned
   !
   address-family evpn
{% for if_name, intf in interfaces.items() if intf.role == 'fabric' %}
      neighbor {{ intf.connects_to.peer_ip.split('/')[0] }} activate
{% endfor %}
{% endif %}
!
end
