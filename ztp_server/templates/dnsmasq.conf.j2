# Rendered per site by generate_topology.py; see write_dnsmasq_configs().
interface=eth1
bind-interfaces
{% if dhcp_range %}
dhcp-range={{ dhcp_range }}
{% if dhcp_router %}
dhcp-option=option:router,{{ dhcp_router }}
{% endif %}
# Tag cEOS requests by DHCP option 60 (vendor class).
dhcp-vendorclass=set:ceos,Arista
# Arista cEOS ZTP: DHCP option 67 (bootfile-name) as an HTTP URL.
dhcp-option=tag:ceos,67,"http://{{ server_ip }}/ztp/script/ceos"
# Nokia SRLinux: placeholder vendor class, not yet verified.
dhcp-vendorclass=set:srlinux,Nokia
# Nokia SRLinux ZTP: DHCP option 239, vendor-specific ZTP script URL.
dhcp-option=tag:srlinux,239,"http://{{ server_ip }}/ztp/script/srlinux"
{% else %}
# No DHCP-ZTP devices on this subnet, so no range is served.
{% endif %}
log-dhcp
