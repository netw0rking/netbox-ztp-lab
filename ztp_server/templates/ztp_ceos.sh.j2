#!/bin/bash
# cEOS-lab ZTP bootstrap script, fetched via DHCP option 67.
SERIAL=$(FastCli -p 15 -c "show version" | grep -i "Serial number" | awk '{print $NF}')
curl -sf "http://{{ server_host }}/ztp/config/${SERIAL}" -o /mnt/flash/startup-config
# Merge into running-config; cEOS does not support reload.
FastCli -p 15 -c "copy flash:startup-config running-config"
