#!/usr/bin/env python3
# FRR bootstrap, run via containerlab exec: (no FRR kind exists).
import json
import os
import subprocess
import time
import urllib.error
import urllib.request


# Idempotent: safe to re-run.
def addr(ip, dev):
    subprocess.run(["ip", "addr", "replace", ip, "dev", dev], check=True)


def ensure_link(name, *args):
    """`ip link add <name> <args...>`, skipped if <name> already exists."""
    if not os.path.exists(f"/sys/class/net/{name}"):
        subprocess.run(["ip", "link", "add", name, *args], check=True)

{% if oob_interface and oob_ip %}
# Static OOB address; wait for the interface to appear first.
for _ in range(30):
    if os.path.exists("/sys/class/net/{{ oob_interface }}"):
        break
    time.sleep(1)
addr("{{ oob_ip }}", "{{ oob_interface }}")
subprocess.run(["ip", "link", "set", "{{ oob_interface }}", "up"], check=True)
{% endif %}

{% if fabric_interfaces %}
# Fabric addresses; skip links not wired in this topology.
{% for if_name, if_ip in fabric_interfaces %}
for _ in range(30):
    if os.path.exists("/sys/class/net/{{ if_name }}"):
        break
    time.sleep(1)
if os.path.exists("/sys/class/net/{{ if_name }}"):
    addr("{{ if_ip }}", "{{ if_name }}")
    subprocess.run(["ip", "link", "set", "{{ if_name }}", "up"], check=True)
else:
    print("{{ if_name }} never appeared - not wired in this topology, skipping")
{% endfor %}
{% endif %}

{% if loopback %}
# Dummy interface as the stable loopback and VTEP source.
ensure_link("lo-vtep", "type", "dummy")
addr("{{ loopback }}", "lo-vtep")
subprocess.run(["ip", "link", "set", "lo-vtep", "up"], check=True)
{% endif %}

{% if vrf_name and l3vni %}
# Routed EVPN VRF setup; must exist before frr.conf loads.
ensure_link("{{ vrf_name }}", "type", "vrf", "table", "{{ l3vni }}")
subprocess.run(["ip", "link", "set", "{{ vrf_name }}", "up"], check=True)
l3vni_if = "vxlan{{ l3vni }}"
l3vni_bridge_if = "br-{{ vrf_name }}"
ensure_link(
    l3vni_if,
    "type", "vxlan", "id", "{{ l3vni }}",
    "dstport", "4789", "local", "{{ loopback.split('/')[0] }}", "nolearning",
)
ensure_link(l3vni_bridge_if, "type", "bridge")
subprocess.run(["ip", "link", "set", l3vni_if, "master", l3vni_bridge_if], check=True)
subprocess.run(["ip", "link", "set", l3vni_bridge_if, "master", "{{ vrf_name }}"], check=True)
subprocess.run(["ip", "link", "set", l3vni_if, "up"], check=True)
subprocess.run(["ip", "link", "set", l3vni_bridge_if, "up"], check=True)

# Host-facing routed links, enslaved into the VRF.
{% for if_name, if_ip in access_interfaces %}
for _ in range(30):
    if os.path.exists("/sys/class/net/{{ if_name }}"):
        break
    time.sleep(1)
addr("{{ if_ip }}", "{{ if_name }}")
subprocess.run(["ip", "link", "set", "{{ if_name }}", "master", "{{ vrf_name }}"], check=True)
subprocess.run(["ip", "link", "set", "{{ if_name }}", "up"], check=True)
{% endfor %}
{% endif %}

serial = "{{ serial }}"
url = "http://{{ server_host }}/ztp/config/" + serial

# Retry the fetch; exec: may run before the server is ready.
config = None
last_error = None
for attempt in range(180):
    try:
        with urllib.request.urlopen(url, timeout=5) as resp:
            config = resp.read().decode()
        break
    except (urllib.error.URLError, OSError) as exc:
        last_error = str(exc)
    time.sleep(10)
if config is None:
    raise SystemExit(f"failed to fetch config from {url} after 180 attempts - last error: {last_error}")

with open("/etc/frr/frr.conf", "w") as f:
    f.write(config)

# Wait for daemons, then validate and load frr.conf with vtysh.
for _ in range(90):
    if subprocess.run(["vtysh", "-c", "show version"], capture_output=True).returncode == 0:
        break
    time.sleep(2)
else:
    raise SystemExit("FRR daemons never became reachable via vtysh")
if not os.path.exists("/etc/frr/vtysh.conf"):
    open("/etc/frr/vtysh.conf", "w").close()
subprocess.run(["vtysh", "-C", "-f", "/etc/frr/frr.conf"], check=True)
subprocess.run(["vtysh", "-f", "/etc/frr/frr.conf"], check=True)

{% if sr_policies %}
# Restart pathd if dead, then apply SR policies via vtysh -c.
def _pathd_alive():
    try:
        with open("/var/run/frr/pathd.pid") as f:
            pid = f.read().strip()
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip() == "pathd"
    except OSError:
        return False


if not _pathd_alive():
    for _pidfile in ("/var/run/frr/pathd.pid", "/var/run/frr/pathd.vty"):
        if os.path.exists(_pidfile):
            os.remove(_pidfile)
    # -s /bin/sh: the frr user's shell is nologin.
    subprocess.run(
        ["su", "-s", "/bin/sh", "frr", "-c", "/usr/lib/frr/pathd -d -F traditional -A 127.0.0.1"],
        check=True,
    )
    time.sleep(2)
sr_policy_cmds = [
    "configure terminal",
    "segment-routing",
    "traffic-eng",
{% for policy in sr_policies %}
    "segment-list {{ policy.name }}-segments",
{% for seg in policy.segments %}
    "index {{ seg.index }} nai prefix {{ seg.nai_prefix }} algorithm 0",
{% endfor %}
    "exit",
    "policy color {{ policy.color }} endpoint {{ policy.endpoint }}",
    "name {{ policy.name }}",
    "candidate-path preference 100 name {{ policy.name }} explicit segment-list {{ policy.name }}-segments",
    "exit",
{% endfor %}
    "exit",
    "exit",
]
vtysh_cmd = ["vtysh"]
for _cmd in sr_policy_cmds:
    vtysh_cmd += ["-c", _cmd]
subprocess.run(vtysh_cmd, check=True)
{% endif %}

{% if overlay_vni and overlay_vlan_id and overlay_test_ip and loopback %}
# zebra discovers the VNI from the kernel's vxlan netdev.
time.sleep(3)
vxlan_if = "vxlan{{ overlay_vni }}"
bridge_if = "br{{ overlay_vlan_id }}"
ensure_link(
    vxlan_if,
    "type", "vxlan", "id", "{{ overlay_vni }}",
    "dstport", "4789", "local", "{{ loopback.split('/')[0] }}", "nolearning",
)
ensure_link(bridge_if, "type", "bridge")
subprocess.run(["ip", "link", "set", vxlan_if, "master", bridge_if], check=True)
addr("{{ overlay_test_ip }}", bridge_if)
subprocess.run(["ip", "link", "set", vxlan_if, "up"], check=True)
subprocess.run(["ip", "link", "set", bridge_if, "up"], check=True)

# Overlay host ports join the same bridge as the VXLAN device.
{% for if_name in overlay_interfaces %}
for _ in range(30):
    if os.path.exists("/sys/class/net/{{ if_name }}"):
        break
    time.sleep(1)
subprocess.run(["ip", "link", "set", "{{ if_name }}", "master", bridge_if], check=True)
subprocess.run(["ip", "link", "set", "{{ if_name }}", "up"], check=True)
{% endfor %}
{% endif %}


# SSH/VTY logins for users.yaml; fetched last so routing is never blocked.
users_url = "http://{{ server_host }}/ztp/users/" + serial
users = None
for attempt in range(30):
    try:
        with urllib.request.urlopen(users_url, timeout=5) as resp:
            users = json.loads(resp.read().decode())
        break
    except (urllib.error.URLError, OSError, ValueError) as exc:
        last_error = str(exc)
    time.sleep(10)
if users is None:
    raise SystemExit(f"failed to fetch users from {users_url} - last error: {last_error}")


def _shadow_field(username):
    with open("/etc/shadow") as f:
        for line in f:
            parts = line.split(":")
            if parts[0] == username:
                return parts[1]
    return None


for user in users:
    name = user["username"]
    if _shadow_field(name) is None:
        subprocess.run(
            ["adduser", "-D", "-s", "/usr/bin/vtysh", "-G", "frrvty", name], check=True
        )
    if user["auth"] == "password":
        subprocess.run(["chpasswd"], input=f"{name}:{user['value']}\n", text=True, check=True)
    elif user["auth"] == "ssh_key":
        # Unlock the account so OpenSSH accepts key login.
        if _shadow_field(name).startswith("!"):
            with open("/etc/shadow") as f:
                lines = f.readlines()
            with open("/etc/shadow", "w") as f:
                for line in lines:
                    if line.startswith(name + ":!"):
                        line = line.replace(name + ":!:", name + ":*:", 1)
                    f.write(line)
        ssh_dir = f"/home/{name}/.ssh"
        os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
        with open(f"{ssh_dir}/authorized_keys", "w") as f:
            f.write(user["value"].strip() + "\n")
        os.chmod(f"{ssh_dir}/authorized_keys", 0o600)
        # busybox adduser -G sets the primary group.
        subprocess.run(["chown", "-R", name, ssh_dir], check=True)
